{
  "name": "verdant-reach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @reach/web -- --host 127.0.0.1",
    "preview": "npm run preview -w @reach/web -- --host 127.0.0.1",
    "build": "tsc --noEmit && npm run build -w @reach/web",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "dev:server": "npm run dev -w @reach/server"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
